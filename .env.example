# Copy this file to .env and replace every "change-me" value.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------- Docker services (docker-compose.yml) ----------
POSTGRES_USER=tigmi
# Use letters and digits only (it is reused inside the URLs below).
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tigmi
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- API (apps/api) ----------
# NODE_ENV is NOT set here: Vite reads this file and a NODE_ENV value would break production builds.
# The API defaults to development; production sets NODE_ENV=production in its real environment.
API_PORT=4000
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://tigmi:changeme@localhost:5432/tigmi
# Used by integration tests only. Must point to a database whose name ends with "_test".
TEST_DATABASE_URL=postgresql://tigmi:changeme@localhost:5432/tigmi_test
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5180
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 in local development).
TRUST_PROXY_HOPS=0
# Secret used to sign access tokens (min. 32 random bytes). Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=changeme-generate-a-real-secret-with-the-command-above
# Send cookies only over HTTPS. Leave false for http://localhost; production forces true.
COOKIE_SECURE=false
# Public URL of the web app; links in emails point here.
APP_URL=http://localhost:5180
# Outgoing email. Defaults target Mailpit (open http://localhost:8025 to read sent emails).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tigmi <no-reply@tigmi.local>"

# ---------- Web (apps/web) ----------
WEB_PORT=5180
# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
