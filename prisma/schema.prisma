// Tigmi database schema.
// Connection URL lives in prisma.config.js (Prisma 7), never in this file.
// Conventions: UUIDv7 ids, snake_case table/column names, timestamps in UTC (timestamptz),
// explicit onDelete on every relation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  fr
  ar
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  fullName          String    @map("full_name") @db.VarChar(100)
  /// Always stored trimmed + lower-cased, so the unique index is case-insensitive in practice.
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash")
  avatarUrl         String?   @map("avatar_url") @db.VarChar(2048)
  preferredLanguage Language  @default(fr) @map("preferred_language")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Brute-force protection: consecutive failed logins and temporary lock.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  auditLogs       AuditLog[]
  userTokens      UserToken[]
  memberships     HouseholdMember[]
  invitationsSent Invitation[]      @relation("InvitationCreatedBy")

  @@map("users")
}

/// One signed-in device/browser. Revoking it signs that device out everywhere instantly.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute lifetime: rotation never extends a session past this point.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Every refresh token ever issued for a session. Only the SHA-256 hash is stored.
/// A token with `usedAt` set has been rotated; presenting it again signals theft.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// A home shared by its members. Every household-scoped table references it.
model Household {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// ISO 4217 code used to display every amount in this household.
  currency    String   @default("MAD") @db.Char(3)
  /// IANA time zone used for due dates, reminders and "this month" boundaries.
  timezone    String   @default("Africa/Casablanca") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members     HouseholdMember[]
  invitations Invitation[]

  @@map("households")
}

/// Links a user to a household with a role. A user has at most one membership per household.
model HouseholdMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

/// An emailed invitation to join a household. Only the SHA-256 of the token is stored.
/// Pending = not accepted, not revoked, not expired. At most one pending invitation per
/// (household, email): re-inviting replaces the previous one.
model Invitation {
  id          String        @id @default(uuid(7)) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  /// Normalised (trimmed, lower-case) address the invitation was sent to.
  email       String        @db.VarChar(254)
  role        HouseholdRole
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  /// Inviter; kept as null if their account is deleted so the history survives.
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, email])
  @@map("invitations")
}

/// Single-use links sent by email (verify address, reset password).
/// Only the SHA-256 hash is stored; the raw token exists only in the email.
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("user_tokens")
}

/// Append-only record of security-relevant and household actions.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Set for household-scoped actions. Deliberately no foreign key: the audit trail of a
  /// deleted household is kept.
  householdId String?  @map("household_id") @db.Uuid
  /// Kept when the user is deleted (SetNull) so history survives.
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([householdId, createdAt])
  @@map("audit_logs")
}
